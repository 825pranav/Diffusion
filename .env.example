# Kafka
KAFKA_BROKER=localhost:9092

# Bluesky (no auth needed — Jetstream is public)
# Posts *and* reposts: reposts are half the propagation signal. The code's
# default already subscribes to both; leave this unset unless changing host.
# BLUESKY_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe?wantedCollections=app.bsky.feed.post&wantedCollections=app.bsky.feed.repost
BLUESKY_RECONNECT_DELAY=5

# Mastodon — public timeline. mastodon.social and mstdn.social now require a
# login for it; hachyderm.io does not. A token works on any instance.
MASTODON_INSTANCE=https://hachyderm.io
MASTODON_ACCESS_TOKEN=
MASTODON_POLL_INTERVAL=30
MASTODON_BATCH_SIZE=40

# GitHub (https://github.com/settings/tokens — public_repo scope)
GITHUB_TOKEN=
GH_POLL_INTERVAL=60

# HN
HN_POLL_INTERVAL=60

# PostgreSQL
POSTGRES_USER=diffusion
POSTGRES_PASSWORD=diffusion
POSTGRES_DB=diffusion
DATABASE_URL=postgresql+asyncpg://diffusion:diffusion@localhost:5432/diffusion

# LLM — auto uses Groq when the key works and serves GROQ_MODEL, else Ollama.
# Groq's free tier allows about one investigation a minute (8,000 tokens/min);
# live traffic raises several anomalies a minute, so ollama keeps up and groq
# does not. Set LLM_BACKEND=groq or ollama to pin one.
LLM_BACKEND=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
