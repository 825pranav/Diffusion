# Kafka
KAFKA_BROKER=localhost:9092

# Bluesky (no auth needed — Jetstream is public)
BLUESKY_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe?wantedCollections=app.bsky.feed.post
BLUESKY_RECONNECT_DELAY=5

# Mastodon (no auth needed — public timeline)
MASTODON_INSTANCE=https://mastodon.social
MASTODON_POLL_INTERVAL=30
MASTODON_BATCH_SIZE=40

# GitHub (https://github.com/settings/tokens — public_repo scope)
GITHUB_TOKEN=
GH_POLL_INTERVAL=60

# HN
HN_POLL_INTERVAL=60

# PostgreSQL
POSTGRES_USER=diffusion
POSTGRES_PASSWORD=diffusion
POSTGRES_DB=diffusion
DATABASE_URL=postgresql+asyncpg://diffusion:diffusion@localhost:5432/diffusion

# LLM
GROQ_API_KEY=
